# Miru Web Configuration
# Optional: External custom anime scraper/metadata API (leave blank to use direct AniList GraphQL)
NEXT_PUBLIC_API_URL=

# Optional: External Go proxy server (defaults to internal Next.js /api/proxy)
NEXT_PUBLIC_PROXY_URL=/api/proxy

# Optional: PocketBase URL for user sync, favorites, comments, and cloud watch history
NEXT_PUBLIC_POCKETBASE_URL=http://localhost:8090

# Optional: Google Analytics measurement ID
NEXT_PUBLIC_GA_ID=

# Environment mode
NODE_ENV=development

# --- Fork settings (see src/fork/README.md) ---
# NEXT_PUBLIC_* values are inlined at build time: restart dev / rebuild after changing.
# Brand (leave blank for Miru defaults)
NEXT_PUBLIC_BRAND=Anime Sama
# Default title becomes "<BRAND> - <TAGLINE>"
NEXT_PUBLIC_BRAND_TAGLINE=
NEXT_PUBLIC_BRAND_DESCRIPTION=
# Paths under /public (e.g. /brand/logo.svg)
NEXT_PUBLIC_BRAND_LOGO=
# Browser tab / PWA icon (favicon). Defaults to /icon.png
NEXT_PUBLIC_BRAND_ICON=
NEXT_PUBLIC_BRAND_APPLE_ICON=
# Hex colours — quote them, e.g. "#22d3ee" (an unquoted # starts a comment)
NEXT_PUBLIC_BRAND_PRIMARY=
NEXT_PUBLIC_BRAND_SECONDARY=
# UI language: en (default) | fr
NEXT_PUBLIC_LANGUAGE=fr
# Features
NEXT_PUBLIC_ENABLE_AUTH=false
NEXT_PUBLIC_ENABLE_COMMENTS=false
# Show brand text next to the logo in navbar/footer (true | blank = hidden)
NEXT_PUBLIC_ENABLE_LOGO_TEXT=
# Embed players: en = Megaplay / VidLink / Autoembed, fr = French sites (VOSTFR / VF)
NEXT_PUBLIC_EMBED_SOURCES=fr
# Primary HLS API player before the embeds (default: true for en, false for fr)
NEXT_PUBLIC_ENABLE_PRIMARY_PLAYER=
# fr only (server-side, no rebuild needed): sites to use, in order, and their current domains
EMBED_PROVIDERS=french-manga,voir-anime,anime-sama
# Provider URLs: comment out a line to disable that provider entirely (no URL = no embeds from it).
FRENCH_MANGA_URL=https://w16.french-manga.net
VOIR_ANIME_URL=https://voir-anime.to
# ANIME_SAMA_URL=https://anime-sama.to
# Rotating proxy for server-side scraping (proxyxoay.org / proxyvn.vn)
# Static HTTP proxy gateway — takes precedence over EMBED_PROXY_API when both are set
EMBED_PROXY_URL=http://user:pass@host:port
# ProxyVN rotating API — omit &live=, it is appended automatically from EMBED_PROXY_LIVE
EMBED_PROXY_API=https://api.proxyxoay.org/api/key_xoay_port.php?key=YOUR_KEY
# IP live time in minutes 1–5 (default: 2; lower = wider pool, higher = more stable)
EMBED_PROXY_LIVE=2
