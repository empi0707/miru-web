# Miru Web Configuration
# Optional: External custom anime scraper/metadata API (leave blank to use direct AniList GraphQL)
NEXT_PUBLIC_API_URL=

# Optional: External Go proxy server (defaults to internal Next.js /api/proxy)
NEXT_PUBLIC_PROXY_URL=/api/proxy

# Optional: PocketBase URL for user sync, favorites, comments, and cloud watch history
NEXT_PUBLIC_POCKETBASE_URL=http://localhost:8090

# Optional: Google Analytics measurement ID
NEXT_PUBLIC_GA_ID=

# Environment mode
NODE_ENV=development

# --- Fork settings (see src/fork/README.md) ---
# NEXT_PUBLIC_* values are inlined at build time: restart dev / rebuild after changing.
# Brand (leave blank for Miru defaults)
NEXT_PUBLIC_BRAND=Anime Sama
# Default title becomes "<BRAND> - <TAGLINE>"
NEXT_PUBLIC_BRAND_TAGLINE=
NEXT_PUBLIC_BRAND_DESCRIPTION=
# Paths under /public (e.g. /brand/logo.svg)
NEXT_PUBLIC_BRAND_LOGO=
NEXT_PUBLIC_BRAND_APPLE_ICON=
# Hex colours — quote them, e.g. "#22d3ee" (an unquoted # starts a comment)
NEXT_PUBLIC_BRAND_PRIMARY=
NEXT_PUBLIC_BRAND_SECONDARY=
# UI language: en (default) | fr
NEXT_PUBLIC_LANGUAGE=fr
# Features
NEXT_PUBLIC_ENABLE_AUTH=false
NEXT_PUBLIC_ENABLE_COMMENTS=false
